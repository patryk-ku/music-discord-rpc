<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

	<Product
		Id='*'
		Name='music-discord-rpc'
		UpgradeCode='EE29A5B5-4DEA-4EFC-B07B-C4B964650CC4'
		Manufacturer='Patryk Kurdziel'
		Language='1033'
		Codepage='1252'
		Version='$(var.Version)'
	>

		<Package
			Id='*'
			Keywords='Installer'
			Description='Cross-platform Discord rich presence for music with album cover and progress bar support.'
			Manufacturer='Patryk Kurdziel'
			InstallerVersion='450'
			Languages='1033'
			Compressed='yes'
			InstallScope='perUser'
			SummaryCodepage='1252'
		/>

		<MajorUpgrade
			Schedule='afterInstallInitialize'
			DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'
		/>

		<Property Id='ALLUSERS' Value='2' />
		<Property Id='MSIINSTALLPERUSER' Value='1' />

		<Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1' />
		<Property Id='DiskPrompt' Value='music-discord-rpc Installation' />

		<Directory Id='TARGETDIR' Name='SourceDir'>
			<Directory Id='LocalAppDataFolder' Name='AppData'>
				<Directory Id='ProgramsFolder' Name='Programs'>
					<Directory Id='APPLICATIONFOLDER' Name='music-discord-rpc'>
						<Component Id='License' Guid='2C93C2D7-AD89-4CC4-80BC-ED407B0319E9'>
							<RegistryValue
								Root='HKCU'
								Key='Software\Patryk Kurdziel\music-discord-rpc'
								Name='License'
								Type='string'
								Value='1'
								KeyPath='yes'
							/>
							<File
								Id='LicenseFile'
								DiskId='1'
								Source='packaging\wix\License.rtf'
							/>
						</Component>

						<Component Id='binary0' Guid='B2DB2075-9DBC-40FE-803E-083BFF1A13F2'>
							<RegistryValue
								Root='HKCU'
								Key='Software\Patryk Kurdziel\music-discord-rpc'
								Name='InstallPath'
								Type='string'
								Value='[APPLICATIONFOLDER]'
								KeyPath='yes'
							/>
							<File
								Id='exe0'
								Name='music-discord-rpc.exe'
								DiskId='1'
								Source='$(var.CargoTargetBinDir)\music-discord-rpc.exe'
							/>
						</Component>

						<Component
							Id='Path'
							Guid='78FB3AA9-0A23-42E1-89F3-D7E848823BDA'
						>
							<RegistryValue
								Root='HKCU'
								Key='Software\Patryk Kurdziel\music-discord-rpc'
								Name='PathEnvironment'
								Type='string'
								Value='1'
								KeyPath='yes'
							/>
							<Environment
								Id='PATH'
								Name='PATH'
								Value='[APPLICATIONFOLDER]'
								Permanent='no'
								Part='last'
								Action='set'
								System='no'
							/>
							<RemoveFolder Id='RemoveApplicationFolder' Directory='APPLICATIONFOLDER' On='uninstall'/>
							<RemoveFolder Id='RemoveProgramsFolder' Directory='ProgramsFolder' On='uninstall'/>
						</Component>
					</Directory>
				</Directory>
			</Directory>
		</Directory>

		<Feature
			Id='Binaries'
			Title='Application'
			Description='Installs all binaries and the license.'
			Level='1'
			ConfigurableDirectory='APPLICATIONFOLDER'
			AllowAdvertise='no'
			Display='expand'
			Absent='disallow'
		>
			<ComponentRef Id='License' />
			<ComponentRef Id='binary0' />

			<Feature
				Id='Environment'
				Title='PATH Environment Variable'
				Description='Add the install location of the [ProductName] executable to the PATH environment variable. This allows the [ProductName] executable to be called from any location.'
				Level='1'
				Absent='allow'
			>
				<ComponentRef Id='Path' />
			</Feature>
		</Feature>

		<SetProperty
			Id='ARPINSTALLLOCATION'
			Value='[APPLICATIONFOLDER]'
			After='CostFinalize'
		/>

		<Property Id='ARPHELPLINK' Value='https://github.com/patryk-ku/music-discord-rpc' />

		<UI>
			<UIRef Id='WixUI_FeatureTree' />
		</UI>

		<WixVariable Id='WixUILicenseRtf' Value='packaging\wix\License.rtf' />
		<WixVariable Id='WixUIBannerBmp' Value='packaging\wix\Banner.bmp' />
		<WixVariable Id='WixUIDialogBmp' Value='packaging\wix\Dialog.bmp' />

	</Product>

</Wix>
